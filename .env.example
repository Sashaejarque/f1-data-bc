# F1 Data Backend - Environment Variables Example

# Frontend Domain (CORS)
# Local development
FRONTEND_URL=http://localhost:5173
# Production (uncomment and update)
# FRONTEND_URL=https://your-frontend-domain.vercel.app

# AI Analysis Service
AI_SERVICE_URL=http://localhost:8080
AI_SERVICE_SECRET=your-shared-secret-key-here

# Cache persistente (análisis de IA, standings) -- opcional. Sin esto configurado, el
# servicio funciona igual pero recalcula todo en cada pedido (sin cache). Ver docs/RAG-PLAN.md.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/f1_analizer

# Rate Limiting (Throttling)
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Server Port (optional)
PORT=3000
